# ============================================
# Database
# ============================================
DATABASE_URL=postgresql+asyncpg://wallet_user:wallet_secret_password@localhost:5432/wallet_db

# ============================================
# Redis
# ============================================
REDIS_URL=redis://localhost:6379/0

# ============================================
# TON Network
# ============================================
# mainnet или testnet
TON_NETWORK=testnet

# TON Center API (бесплатный доступ к TON)
# Получить ключ: https://toncenter.com/
TON_CENTER_API_KEY=your_toncenter_api_key

# ============================================
# Hot Wallet (ВАЖНО: держать в секрете!)
# ============================================
# 24 слова мнемоники hot wallet
HOT_WALLET_MNEMONIC=word1 word2 word3 ... word24

# ============================================
# Cold Wallet (только адрес, ключи оффлайн)
# ============================================
COLD_WALLET_ADDRESS=EQxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# USDT Jetton (TON)
# ============================================
# Mainnet USDT: EQCxE6mUtQJKFnGfaROTKOt1lZbDiiX1kCixRv7Nw2Id_sDs
# Testnet USDT: нужно задеплоить тестовый jetton
USDT_JETTON_MASTER=EQCxE6mUtQJKFnGfaROTKOt1lZbDiiX1kCixRv7Nw2Id_sDs

# ============================================
# Fee Configuration
# ============================================
# Буфер на волатильность курса (15%)
GAS_FEE_BUFFER=0.15

# Минимальный TON баланс для алерта
MIN_TON_BALANCE_WARNING=10.0
MIN_TON_BALANCE_CRITICAL=2.0

# Threshold для sweep (в USDT)
SWEEP_THRESHOLD_USDT=10.0

# ============================================
# Telegram (для алертов)
# ============================================
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_ADMIN_CHAT_ID=your_chat_id

# ============================================
# Security
# ============================================
# Секретный ключ для JWT/подписей
SECRET_KEY=your-super-secret-key-change-in-production

# ============================================
# App
# ============================================
DEBUG=true
LOG_LEVEL=INFO